# ──────────────────────────────────────────────────────────────
#  .env.example — Agentic Commerce / Razorpay AI Buildathon
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# ── Backend ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_commerce
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_commerce
DB_USER=user
DB_PASSWORD=change-me

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── AI / LLM Services ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── MQTT Broker (IoT / Agentic triggers) ─────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=change-me

# ── Redis (caching / session / queues) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Container Registry (for CD pipeline) ─────────────────────
REGISTRY_URL=ghcr.io
REGISTRY_USERNAME=your_github_username
REGISTRY_TOKEN=your_github_pat_here

# ── Cloud Deployment (configure once infra is ready) ─────────
DEPLOY_HOST=your.server.ip.or.hostname
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=your_private_ssh_key_contents_here
DEPLOY_PATH=/opt/agentic-commerce

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
VITE_APP_ENV=development
